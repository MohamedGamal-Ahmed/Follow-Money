<?xml version="1.0" encoding="utf-8"?>
<!-- Separate provider sizes keep each summary focused. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
    android:layoutDirection="rtl" android:background="@drawable/widget_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_logo_mark" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/widget_today_currency" android:textSize="10sp" android:textColor="#E6EFEA" android:fontFamily="sans-serif-medium" android:singleLine="true" />
    <TextView android:id="@+id/widget_remaining" android:layout_width="0dp" android:layout_weight="1" android:layout_height="26dp" android:layout_marginStart="8dp" android:gravity="end|center_vertical"
        android:text="@string/widget_preview_remaining_short" android:textSize="20sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="17dp" android:gravity="center_vertical"
        android:text="@string/widget_preview_spent_short" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:textColor="#B9D3C8" android:singleLine="true" android:ellipsize="end" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp"
        android:layout_marginTop="3dp" android:max="100" android:progressDrawable="@drawable/widget_progress" />
    <ProgressBar android:id="@+id/widget_progress_over" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp"
        android:layout_marginTop="3dp" android:max="100" android:progress="100" android:progressDrawable="@drawable/widget_progress_over" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="26dp" android:gravity="center"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/widget_pill"
            android:text="@string/widget_add_action" android:textSize="11sp" android:textColor="#0B3D2E" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="26dp" android:gravity="center" android:layout_marginStart="8dp"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/widget_pill_ghost"
            android:text="@string/widget_transactions_action" android:textSize="11sp" android:textColor="#E6EFEA" />
        <TextView android:id="@+id/widget_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end"
            android:textSize="9sp" android:textColor="#8FB3A5" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
