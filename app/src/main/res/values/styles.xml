<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0B3D2E</item>
        <item name="android:colorControlActivated">#0B3D2E</item>
        <item name="android:statusBarColor">#F4F5F1</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
    </style>
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2BBF85</item>
        <item name="android:colorControlActivated">#2BBF85</item>
        <item name="android:statusBarColor">#0D1A16</item>
        <item name="android:navigationBarColor">#0D1A16</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog.Dark</item>
    </style>
    <style name="AppAlertDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">#0B3D2E</item>
        <item name="android:colorControlActivated">#0B3D2E</item>
        <item name="android:textColorPrimary">#0D1F1A</item>
        <item name="android:textColorSecondary">#5E6B66</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogPrimaryButton</item>
    </style>
    <style name="AppAlertDialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background_dark</item>
        <item name="android:colorAccent">#2BBF85</item>
        <item name="android:colorControlActivated">#2BBF85</item>
        <item name="android:textColorPrimary">#EEF3EF</item>
        <item name="android:textColorSecondary">#9AAAA2</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogPrimaryButton.Dark</item>
    </style>
    <style name="AppDialogPrimaryButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:background">@drawable/dialog_primary_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="AppDialogPrimaryButton.Dark">
        <item name="android:background">@drawable/dialog_primary_button_dark</item>
    </style>
</resources>
