<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_forest</item>
        <item name="android:colorControlActivated">@color/brand_forest</item>
        <item name="android:statusBarColor">@color/ui_background_light</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
        <item name="android:datePickerStyle">@style/AppDatePicker</item>
    </style>
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_accent_dark</item>
        <item name="android:colorControlActivated">@color/ui_accent_dark</item>
        <item name="android:statusBarColor">@color/ui_background_dark</item>
        <item name="android:navigationBarColor">@color/ui_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog.Dark</item>
        <item name="android:datePickerStyle">@style/AppDatePicker</item>
    </style>
    <!-- Spinner mode: the calendar mode draws a grey header block and a month grid that do not fit the app dialogs. -->
    <style name="AppDatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
    </style>
    <style name="AppAlertDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">@color/brand_forest</item>
        <item name="android:colorControlActivated">@color/brand_forest</item>
        <item name="android:textColorPrimary">@color/ui_ink_light</item>
        <item name="android:textColorSecondary">@color/ui_muted_light</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogPrimaryButton</item>
    </style>
    <style name="AppAlertDialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background_dark</item>
        <item name="android:colorAccent">@color/ui_accent_dark</item>
        <item name="android:colorControlActivated">@color/ui_accent_dark</item>
        <item name="android:textColorPrimary">@color/ui_ink_dark</item>
        <item name="android:textColorSecondary">@color/ui_muted_dark</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogPrimaryButton.Dark</item>
    </style>
    <style name="AppDialogPrimaryButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:background">@drawable/dialog_primary_button</item>
        <item name="android:textColor">@color/ui_surface_light</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="AppDialogPrimaryButton.Dark">
        <item name="android:background">@drawable/dialog_primary_button_dark</item>
        <!-- White on the accent is 2.4:1; dark ink is 7.6:1. -->
        <item name="android:textColor">@color/ui_background_dark</item>
    </style>
</resources>
