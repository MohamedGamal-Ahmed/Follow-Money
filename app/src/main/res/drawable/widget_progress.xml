<?xml version="1.0" encoding="utf-8"?>
<!-- Thin rounded meter: lime while within the daily limit. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#2A6352" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#C8F25A" /><corners android:radius="4dp" /></shape></clip>
    </item>
</layer-list>
